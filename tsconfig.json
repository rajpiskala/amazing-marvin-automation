{
  "compilerOptions": {
    "lib": ["ES2023"],
    "target": "ES2023",
    "module": "Node16",
    "esModuleInterop": true,
    "moduleResolution": "Node16",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "jest"]
  },
  "include": ["src/**/*.ts", "lib/**/*.ts", "test/**/*.ts"]
}
